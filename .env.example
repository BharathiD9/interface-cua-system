# Copy to .env and fill in ONE provider key. Never commit the real .env.

# Groq (free tier) -- get one at https://console.groq.com  -> API Keys
GROQ_API_KEY=gsk_...

# Anthropic (paid) -- https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model for whichever provider you chose.
# Groq default:      llama-3.3-70b-versatile
# Anthropic default: claude-sonnet-5
# CUA_MODEL=llama-3.3-70b-versatile

TARGET_APP_URL=http://127.0.0.1:5051
